{
  "name": "voltring",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/chakra-petch": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test && npx expo-doctor",
    "gen:audio": "node scripts/generate-audio.mjs",
    "gen:icons": "node scripts/generate-icons.mjs",
    "build:dev": "npx eas-cli@latest build --profile development --platform android",
    "build:preview": "npx eas-cli@latest build --profile preview --platform android",
    "build:prod": "npx eas-cli@latest build --profile production --platform android",
    "submit:prod": "npx eas-cli@latest submit --profile production --platform android",
    "gen:feature": "python scripts/generate-feature-graphic.py"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  }
}
