# Copy to .env for local development. Every EXPO_PUBLIC_* value is bundled into the app
# and is PUBLIC by design. NEVER put a Supabase service-role key or any secret here.

# development | preview | production (EAS profiles set this automatically)
EXPO_PUBLIC_APP_ENV=development

# Supabase project (Project Settings > API). Use the anon / publishable key only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AdMob. Leave empty in development: Google's official test IDs are used automatically.
# Production builds fail fast if these are missing.
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=

# Required before Play submission (must be real, public URLs you control).
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
