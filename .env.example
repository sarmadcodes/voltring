# Copy to .env for local development. Every EXPO_PUBLIC_* value is bundled into the app
# and is PUBLIC by design. The game has no backend and no ads, so there are no secrets to set.

# development | preview | production (EAS profiles set this automatically)
EXPO_PUBLIC_APP_ENV=development

# Required before Play submission (must be real, public URLs you control).
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
